# MySQL: mysql://usuario:password@host:puerto/nombre_bd
DATABASE_URL="mysql://root:password@localhost:3306/toledo21_crm"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# URL publica desde la que se sirve esta API (para construir URLs de imagenes
# en el feed). En local puede dejarse vacio; en produccion, la URL real.
PUBLIC_BASE_URL=""

# --- Feed de propiedades (para el plugin Houzez Property Feed u otros) ---
# Token que debe incluirse como ?token=... al pedir /api/feed/properties.json|xml
FEED_ACCESS_TOKEN="cambia-esto-por-un-token-largo-y-aleatorio"

# --- Autenticacion ---
# Cambia esto por una cadena aleatoria larga antes de desplegar a produccion.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
# Codigo que deben introducir los nuevos empleados para poder registrarse.
TEAM_INVITE_CODE="toledo21-2026"

# --- Proveedor de IA (opcional, fase 2 - valoracion y mensajes) ---
AI_PROVIDER="" # "anthropic" | "openai"
AI_API_KEY=""

# --- WhatsApp / Email (opcional, fase 2 - automatizacion de seguimiento) ---
WHATSAPP_PROVIDER="" # "meta_cloud_api" | "twilio"
WHATSAPP_API_KEY=""
EMAIL_PROVIDER="" # "resend" | "sendgrid"
EMAIL_API_KEY=""
