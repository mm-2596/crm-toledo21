generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum ContactSource {
  WEB_HOUZEZ
  MANUAL
  WHATSAPP
  EMAIL
  PHONE
  REFERRAL
  OTHER
}

enum PropertyType {
  PISO
  CASA
  CHALET
  ATICO
  DUPLEX
  ESTUDIO
  LOCAL
  OFICINA
  GARAJE
  TERRENO
  NAVE_INDUSTRIAL
  TRASTERO
  OTRO
}

enum PropertyCondition {
  NUEVO
  BUEN_ESTADO
  A_REFORMAR
  REFORMADO
}

enum HeatingType {
  NINGUNA
  INDIVIDUAL
  CENTRAL
}

enum PropertyStatus {
  DISPONIBLE
  RESERVADO
  VENDIDO
  ALQUILADO
  RETIRADO
}

enum ListingType {
  VENTA
  ALQUILER
}

enum ActivityType {
  LLAMADA
  EMAIL
  WHATSAPP
  VISITA
  NOTA
  TAREA
  REUNION
}

enum DealStatus {
  ABIERTO
  GANADO
  PERDIDO
}

enum ContactPriority {
  ALTA
  MEDIA
  BAJA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  phone        String?
  photoUrl     String?
  jobTitle     String?
  bio          String?  @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  /// Último día (Madrid, AAAA-MM-DD) en que se le envió el resumen de agenda matinal.
  lastDigestOn String?

  deals      Deal[]
  activities Activity[]
  properties Property[]
  reviews    AgentReview[]
}

model AgentReview {
  id         String   @id @default(cuid())
  agentId    String
  authorName String
  rating     Int
  comment    String   @db.Text
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  agent User @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([approved])
}

model Contact {
  id             String           @id @default(cuid())
  name           String
  email          String?
  phone          String?
  source         ContactSource    @default(MANUAL)
  budgetMin      Int?
  budgetMax      Int?
  preferredZone  String?
  propertyType   PropertyType?
  listingType    ListingType?
  bedroomsMin    Int?
  needsFinancing Boolean?
  priority       ContactPriority?
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  /// Consentimiento para recibir comunicaciones comerciales (RGPD / LSSI).
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  unsubscribedAt     DateTime?
  /// Token del enlace de baja de los emails. Se genera al enviar la primera campaña.
  unsubscribeToken   String?   @unique

  deals      Deal[]
  activities Activity[]

  @@index([email])
  @@index([phone])
}

model Property {
  id                     String             @id @default(cuid())
  reference              String             @unique
  title                  String
  type                   PropertyType
  listingType            ListingType        @default(VENTA)
  status                 PropertyStatus     @default(DISPONIBLE)
  price                  Int
  city                   String?
  zone                   String?
  address                String?
  latitude               Float?
  longitude              Float?
  bedrooms               Int?
  bathrooms              Int?
  areaM2                 Int?
  usableAreaM2           Int?
  floor                  Int?
  hasElevator            Boolean?
  energyRating           String?
  energyConsumptionValue Float?
  energyEmissionsRating  String?
  energyEmissionsValue   Float?
  condition              PropertyCondition?
  yearBuilt              Int?
  parkingSpaces          Int?
  heating                HeatingType?
  hasAirConditioning     Boolean?
  hasTerrace             Boolean?
  hasBalcony             Boolean?
  hasGarden              Boolean?
  hasPool                Boolean?
  hasStorageRoom         Boolean?
  isFurnished            Boolean?
  isExterior             Boolean?
  hoaFees                Int?
  description            String?            @db.Text
  houzezId               String?            @unique
  agentId                String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  agent      User?           @relation(fields: [agentId], references: [id])
  deals      Deal[]
  valuations Valuation[]
  images     PropertyImage[]
  videos     PropertyVideo[]

  @@index([city])
  @@index([status])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyVideo {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PipelineStage {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @unique

  deals Deal[]
}

model Deal {
  id                String     @id @default(cuid())
  contactId         String
  propertyId        String?
  stageId           String
  agentId           String?
  status            DealStatus @default(ABIERTO)
  value             Int?
  expectedCloseDate DateTime?
  notes             String?    @db.Text
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  property   Property?     @relation(fields: [propertyId], references: [id])
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  agent      User?         @relation(fields: [agentId], references: [id])
  activities Activity[]

  @@index([stageId])
  @@index([contactId])
}

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType
  description    String       @db.Text
  dueDate        DateTime?
  /// true si dueDate incluye una hora concreta; si no, solo cuenta el día.
  hasTime        Boolean      @default(false)
  reminderSentAt DateTime?
  completed      Boolean      @default(false)
  contactId      String?
  dealId         String?
  agentId        String?
  createdAt      DateTime     @default(now())

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  agent   User?    @relation(fields: [agentId], references: [id])

  @@index([contactId])
  @@index([dealId])
  @@index([dueDate])
}

/// Registro de valoraciones (manuales o generadas por IA en una fase posterior)
model Valuation {
  id             String   @id @default(cuid())
  propertyId     String?
  source         String   @default("manual") // "manual" | "ai"
  estimatedValue Int
  inputData      Json?
  factors        Json?
  createdAt      DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

enum CampaignStatus {
  BORRADOR
  ENVIANDO
  ENVIADA
}

/// Campaña de email marketing enviada desde el CRM.
model Campaign {
  id             String         @id @default(cuid())
  name           String
  subject        String
  body           String         @db.Text
  ctaLabel       String?
  ctaUrl         String?
  /// Filtros de audiencia (ver routes/campaigns.ts). Siempre se exige consentimiento y no estar dado de baja.
  segment        Json?
  status         CampaignStatus @default(BORRADOR)
  recipientCount Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  createdAt      DateTime       @default(now())
  sentAt         DateTime?

  sends CampaignSend[]
}

model CampaignSend {
  id         String   @id @default(cuid())
  campaignId String
  contactId  String
  email      String
  status     String // "ENVIADO" | "ERROR"
  error      String?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactId])
}
