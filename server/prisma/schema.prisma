generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  AGENT
  /// Gestión de alquileres de una oficina (o de todas si no tiene oficina asignada).
  ADMINISTRACION
}

enum ContactSource {
  WEB_HOUZEZ
  MANUAL
  WHATSAPP
  EMAIL
  PHONE
  REFERRAL
  OTHER
}

enum PropertyType {
  PISO
  CASA
  CHALET
  ATICO
  DUPLEX
  ESTUDIO
  LOCAL
  OFICINA
  GARAJE
  TERRENO
  NAVE_INDUSTRIAL
  TRASTERO
  OTRO
}

enum PropertyCondition {
  NUEVO
  BUEN_ESTADO
  A_REFORMAR
  REFORMADO
}

enum HeatingType {
  NINGUNA
  INDIVIDUAL
  CENTRAL
}

enum PropertyStatus {
  DISPONIBLE
  RESERVADO
  VENDIDO
  ALQUILADO
  RETIRADO
}

enum ListingType {
  VENTA
  ALQUILER
}

enum ActivityType {
  LLAMADA
  EMAIL
  WHATSAPP
  VISITA
  NOTA
  TAREA
  REUNION
}

enum DealStatus {
  ABIERTO
  GANADO
  PERDIDO
}

enum ContactPriority {
  ALTA
  MEDIA
  BAJA
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  passwordHash     String
  role             Role     @default(AGENT)
  phone            String?
  photoUrl         String?
  jobTitle         String?
  bio              String?  @db.Text
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  /// Último día (Madrid, AAAA-MM-DD) en que se le envió el resumen de agenda matinal.
  lastDigestOn     String?
  /// Oficina a la que pertenece: un agente solo ve los edificios y viviendas de su oficina.
  office           Office?
  /// Permiso que concede un administrador para usar el mapa de viviendas (los administradores siempre lo tienen).
  canViewBuildings Boolean  @default(false)

  deals      Deal[]
  activities Activity[]
  properties Property[]
  reviews    AgentReview[]
}

model AgentReview {
  id         String   @id @default(cuid())
  agentId    String
  authorName String
  rating     Int
  comment    String   @db.Text
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  agent User @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([approved])
}

model Contact {
  id             String           @id @default(cuid())
  name           String
  email          String?
  phone          String?
  source         ContactSource    @default(MANUAL)
  budgetMin      Int?
  budgetMax      Int?
  preferredZone  String?
  propertyType   PropertyType?
  listingType    ListingType?
  bedroomsMin    Int?
  needsFinancing Boolean?
  /// Qué es para nosotros: busca comprar, busca alquilar o ya ha comprado.
  segment        ClientSegment?
  /// Datos económicos para estimar si puede permitirse lo que busca (orientativo).
  savings        Int?
  monthlyIncome  Int?
  monthlyDebts   Int?
  priority       ContactPriority?
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  /// Consentimiento para recibir comunicaciones comerciales (RGPD / LSSI).
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  unsubscribedAt     DateTime?
  /// Token del enlace de baja de los emails. Se genera al enviar la primera campaña.
  unsubscribeToken   String?   @unique

  deals        Deal[]
  activities   Activity[]
  dwellings    Dwelling[]
  searches     ContactSearch[]
  ownerLeases  Lease[]         @relation("LeaseOwner")
  tenantLeases Lease[]         @relation("LeaseTenant")

  @@index([email])
  @@index([phone])
}

model Property {
  id                     String             @id @default(cuid())
  reference              String             @unique
  title                  String
  type                   PropertyType
  listingType            ListingType        @default(VENTA)
  status                 PropertyStatus     @default(DISPONIBLE)
  price                  Int
  city                   String?
  zone                   String?
  address                String?
  latitude               Float?
  longitude              Float?
  bedrooms               Int?
  bathrooms              Int?
  areaM2                 Int?
  usableAreaM2           Int?
  floor                  Int?
  hasElevator            Boolean?
  energyRating           String?
  energyConsumptionValue Float?
  energyEmissionsRating  String?
  energyEmissionsValue   Float?
  condition              PropertyCondition?
  yearBuilt              Int?
  parkingSpaces          Int?
  heating                HeatingType?
  hasAirConditioning     Boolean?
  hasTerrace             Boolean?
  hasBalcony             Boolean?
  hasGarden              Boolean?
  hasPool                Boolean?
  hasStorageRoom         Boolean?
  isFurnished            Boolean?
  isExterior             Boolean?
  hoaFees                Int?
  description            String?            @db.Text
  houzezId               String?            @unique
  agentId                String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  agent      User?           @relation(fields: [agentId], references: [id])
  deals      Deal[]
  valuations Valuation[]
  images     PropertyImage[]
  videos     PropertyVideo[]
  activities Activity[]

  @@index([city])
  @@index([status])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyVideo {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PipelineStage {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @unique

  deals Deal[]
}

model Deal {
  id                String     @id @default(cuid())
  contactId         String
  propertyId        String?
  stageId           String
  agentId           String?
  status            DealStatus @default(ABIERTO)
  value             Int?
  expectedCloseDate DateTime?
  notes             String?    @db.Text
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  property   Property?     @relation(fields: [propertyId], references: [id])
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  agent      User?         @relation(fields: [agentId], references: [id])
  activities Activity[]

  @@index([stageId])
  @@index([contactId])
}

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType
  description    String       @db.Text
  dueDate        DateTime?
  /// true si dueDate incluye una hora concreta; si no, solo cuenta el día.
  hasTime        Boolean      @default(false)
  reminderSentAt DateTime?
  completed      Boolean      @default(false)
  contactId      String?
  dealId         String?
  agentId        String?
  /// Vivienda a la que pertenece la anotación del diario o la tarea programada.
  dwellingId     String?
  /// Inmueble de la lista de Propiedades al que se refiere (p. ej. una visita agendada).
  propertyId     String?
  /// Dónde se queda (visitas): por defecto la dirección del inmueble.
  location       String?
  leaseId        String?
  /// Marca los recordatorios que crea el CRM solo (p. ej. fin de contrato) para poder recalcularlos.
  autoKind       String?
  createdAt      DateTime     @default(now())

  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal     Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  agent    User?     @relation(fields: [agentId], references: [id])
  dwelling Dwelling? @relation(fields: [dwellingId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lease    Lease?    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([dwellingId])
  @@index([dealId])
  @@index([leaseId])
  @@index([dueDate])
}

/// Registro de valoraciones (manuales o generadas por IA en una fase posterior)
model Valuation {
  id             String   @id @default(cuid())
  propertyId     String?
  source         String   @default("manual") // "manual" | "ai"
  estimatedValue Int
  inputData      Json?
  factors        Json?
  createdAt      DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

enum CampaignStatus {
  BORRADOR
  ENVIANDO
  ENVIADA
}

/// Campaña de email marketing enviada desde el CRM.
model Campaign {
  id             String         @id @default(cuid())
  name           String
  subject        String
  body           String         @db.Text
  ctaLabel       String?
  ctaUrl         String?
  /// Filtros de audiencia (ver routes/campaigns.ts). Siempre se exige consentimiento y no estar dado de baja.
  segment        Json?
  status         CampaignStatus @default(BORRADOR)
  recipientCount Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  createdAt      DateTime       @default(now())
  sentAt         DateTime?

  sends CampaignSend[]
}

model CampaignSend {
  id         String   @id @default(cuid())
  campaignId String
  contactId  String
  email      String
  status     String // "ENVIADO" | "ERROR"
  error      String?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactId])
}

enum Office {
  GETAFE
  LEGANES
  LAS_ROZAS
  PUERTO_SAGUNTO
}

enum DwellingStatus {
  CENSADA
  A_LA_VENTA
  VENDIDA
  ALQUILADA
}

/// Edificio censado, con coordenadas para pintarlo en el mapa de su oficina.
model Building {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String?
  office    Office
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  dwellings Dwelling[]

  @@index([office])
}

/// Vivienda dentro de un edificio (haya o no un anuncio publicado).
model Dwelling {
  id           String         @id @default(cuid())
  buildingId   String
  floor        String?
  door         String?
  status       DwellingStatus @default(CENSADA)
  /// Cliente principal (propietario) para poder buscar la vivienda por su nombre.
  contactId    String?
  notes        String?        @db.Text
  /// Fase del seguimiento de venta (solo cuando la vivienda se ha cogido a la venta).
  saleStage    SaleStage?
  saleStageAt  DateTime?
  /// Características para poder cruzarla con lo que buscan los clientes.
  price        Int?
  propertyType PropertyType?
  bedrooms     Int?
  bathrooms    Int?
  areaM2       Int?
  createdAt    DateTime       @default(now())

  building   Building           @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  contact    Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  residents  DwellingResident[]
  files      DwellingFile[]
  activities Activity[]
  leases     Lease[]

  @@index([buildingId])
  @@index([contactId])
}

enum SaleStage {
  ENCARGO_VIGENTE
  RESERVADO
  ARRAS
  PENDIENTE_ESCRITURA
  FIRMADO_NOTARIO
}

enum ResidentRole {
  PROPIETARIO
  INQUILINO
  HIJO_PROPIETARIO
  FAMILIAR
  OTRO
}

/// Persona que vive en una vivienda (propietario, inquilino, hijo, familiar...).
model DwellingResident {
  id         String       @id @default(cuid())
  dwellingId String
  name       String
  role       ResidentRole
  phone      String?
  email      String?
  notes      String?      @db.Text
  createdAt  DateTime     @default(now())

  dwelling Dwelling @relation(fields: [dwellingId], references: [id], onDelete: Cascade)

  @@index([dwellingId])
}

/// Documento adjunto a una vivienda. Se guarda en la base de datos (no en el disco del
/// servidor, que se borra en cada despliegue) y solo se sirve a quien tiene acceso a la oficina.
model DwellingFile {
  id         String   @id @default(cuid())
  dwellingId String
  name       String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  dwelling Dwelling @relation(fields: [dwellingId], references: [id], onDelete: Cascade)

  @@index([dwellingId])
}

enum ClientSegment {
  BUSCA_COMPRAR
  BUSCA_ALQUILER
  HA_COMPRADO
  PROPIETARIO
  INQUILINO
}

/// Una cosa concreta que busca un cliente (puede buscar varias: un piso y un garaje, por ejemplo).
model ContactSearch {
  id           String       @id @default(cuid())
  contactId    String
  propertyType PropertyType
  listingType  ListingType  @default(VENTA)
  budgetMin    Int?
  budgetMax    Int?
  /// Zonas o ciudades separadas por comas.
  zones        String?
  bedroomsMin  Int?
  bathroomsMin Int?
  areaMin      Int?
  notes        String?      @db.Text
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

enum LeaseStatus {
  VIGENTE
  FINALIZADO
}

/// Contrato de alquiler de una vivienda: propietario, arrendatario, renta, fechas y documentos.
model Lease {
  id          String      @id @default(cuid())
  dwellingId  String
  ownerId     String?
  tenantId    String?
  monthlyRent Int
  deposit     Int?
  startDate   DateTime
  endDate     DateTime?
  status      LeaseStatus @default(VIGENTE)
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  dwelling   Dwelling    @relation(fields: [dwellingId], references: [id], onDelete: Cascade)
  owner      Contact?    @relation("LeaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tenant     Contact?    @relation("LeaseTenant", fields: [tenantId], references: [id], onDelete: SetNull)
  files      LeaseFile[]
  activities Activity[]

  @@index([dwellingId])
  @@index([ownerId])
  @@index([tenantId])
  @@index([status])
}

/// Documento de un alquiler (contrato, DNI, seguro…). Se guarda en la base de datos, como los de las viviendas.
model LeaseFile {
  id        String   @id @default(cuid())
  leaseId   String
  name      String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  lease Lease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId])
}
